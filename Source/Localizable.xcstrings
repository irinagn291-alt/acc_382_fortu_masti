        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر حارسًا عاجي اللون ثم نقطة مضيئة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取象牙色守衛，再點亮起的交點。"
          }
