    "Reach a golden gate. Tap a lit point to move.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reach a golden gate. Tap a lit point to move."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Reach a golden gate. Tap a lit point to move."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Reach a golden gate. Tap a lit point to move."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتجه إلى بوابة ذهبية. انقر نقطة مضيئة للتحرك."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往任一金色關口。輕點亮起的交點移動。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcance um portão dourado. Toque em um ponto iluminado para mover."
          }
        }
      }
    },
    "Choose an ivory warden, then a lit point.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an ivory warden, then a lit point."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
